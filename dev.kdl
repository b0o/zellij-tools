default_layout "dev-layout"
default_mode "locked"
default_shell "nu"
layout_dir "."
mouse_hover_effects false
pane_frame_style "full"
pane_frames false
scroll_buffer_size 20000
show_startup_tips false
visual_bell true

keybinds clear-defaults=true {
  locked {
    bind "Ctrl space" { SwitchToMode "normal"; }
  }

  normal {
    bind "h" { MoveFocus "left"; }
    bind "j" { ScrollDown; SwitchToMode "scroll"; }
    bind "k" { ScrollUp; SwitchToMode "scroll"; }
    bind "l" { MoveFocus "right"; }
    bind "p" { SwitchToMode "pane"; }
    bind "r" { SwitchToMode "resize"; }
    bind "s" { SwitchToMode "scroll"; }
    bind "t" { SwitchToMode "tab"; }
    bind "o" { SwitchToMode "session"; }
    bind "Shift S" { NewPane "down"; SwitchToMode "locked"; }
    bind "Shift V" { NewPane "right"; SwitchToMode "locked"; }
    bind "+" "=" { Resize "Increase"; }
    bind "-" { Resize "Decrease"; }
    bind "1" { GoToTab 1; }
    bind "2" { GoToTab 2; }
    bind "3" { GoToTab 3; }
    bind "4" { GoToTab 4; }
    bind "5" { GoToTab 5; }
    bind "6" { GoToTab 6; }
    bind "7" { GoToTab 7; }
    bind "8" { GoToTab 8; }
    bind "9" { GoToTab 9; }
    bind "0" { GoToTab 10; }
    bind ";" { GoToPreviousTab; }
    bind "'" { GoToNextTab; }
    bind "Enter" { NewTab; }
  }

  shared_among "normal" "locked" {
    bind "Alt Shift A" { FocusLastPane; }
    bind "Alt Shift H" { MoveFocus "left"; }
    bind "Alt Shift J" { MoveFocus "down"; }
    bind "Alt Shift K" { MoveFocus "up"; }
    bind "Alt Shift L" { MoveFocus "right"; }
    bind "Ctrl Shift D" {
      MessagePlugin "zellij-tools" { payload "zellij-tools::scratchpad::toggle::dev"; }
      SwitchToMode "locked"
    }
    bind "Ctrl Shift B" {
      MessagePlugin "zellij-tools" { payload "zellij-tools::scratchpad::toggle::monitor"; }
      SwitchToMode "locked"
    }
    bind "Ctrl Shift G" {
      MessagePlugin "zellij-tools" { payload "zellij-tools::scratchpad::toggle::git"; }
      SwitchToMode "locked"
    }
    bind "Ctrl Shift N" {
      MessagePlugin "zellij-tools" { payload "zellij-tools::scratchpad::toggle::notes"; }
      SwitchToMode "locked"
    }
    bind "Ctrl Shift R" {
      MessagePlugin "zellij-tools" { payload "zellij-tools::zjstatus::refresh"; }
      SwitchToMode "locked"
    }
  }

  pane {
    bind "h" "left" { MoveFocus "left"; }
    bind "j" "down" { MoveFocus "down"; }
    bind "k" "up" { MoveFocus "up"; }
    bind "l" "right" { MoveFocus "right"; }
    bind "d" { NewPane "down"; SwitchToMode "locked"; }
    bind "v" "r" { NewPane "right"; SwitchToMode "locked"; }
    bind "n" { NewPane; SwitchToMode "locked"; }
    bind "x" { CloseFocus; SwitchToMode "locked"; }
    bind "f" { ToggleFocusFullscreen; SwitchToMode "locked"; }
    bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "locked"; }
    bind "w" { ToggleFloatingPanes; SwitchToMode "locked"; }
    bind "z" { TogglePaneFrames; SwitchToMode "locked"; }
    bind "p" { SwitchToMode "normal"; }
    bind "tab" { SwitchFocus; }
  }

  tab {
    bind "h" "left" "k" "up" { GoToPreviousTab; }
    bind "j" "down" "l" "right" { GoToNextTab; }
    bind "n" { NewTab; SwitchToMode "locked"; }
    bind "x" { CloseTab; SwitchToMode "locked"; }
    bind "r" { SwitchToMode "renametab"; TabNameInput 0; }
    bind "s" { ToggleActiveSyncTab; SwitchToMode "locked"; }
    bind "t" { SwitchToMode "normal"; }
    bind "1" { GoToTab 1; SwitchToMode "locked"; }
    bind "2" { GoToTab 2; SwitchToMode "locked"; }
    bind "3" { GoToTab 3; SwitchToMode "locked"; }
    bind "4" { GoToTab 4; SwitchToMode "locked"; }
    bind "5" { GoToTab 5; SwitchToMode "locked"; }
    bind "6" { GoToTab 6; SwitchToMode "locked"; }
    bind "7" { GoToTab 7; SwitchToMode "locked"; }
    bind "8" { GoToTab 8; SwitchToMode "locked"; }
    bind "9" { GoToTab 9; SwitchToMode "locked"; }
    bind "0" { GoToTab 10; SwitchToMode "locked"; }
  }

  resize {
    bind "h" "left" { Resize "Increase left"; }
    bind "j" "down" { Resize "Increase down"; }
    bind "k" "up" { Resize "Increase up"; }
    bind "l" "right" { Resize "Increase right"; }
    bind "+" "=" { Resize "Increase"; }
    bind "-" { Resize "Decrease"; }
    bind "r" { SwitchToMode "normal"; }
  }

  shared_among "scroll" "search" {
    bind "j" "down" { ScrollDown; }
    bind "k" "up" { ScrollUp; }
    bind "h" "left" "PageUp" { PageScrollUp; }
    bind "l" "right" "PageDown" { PageScrollDown; }
    bind "d" "Shift J" { HalfPageScrollDown; }
    bind "u" "Shift K" { HalfPageScrollUp; }
    bind "Ctrl c" { ScrollToBottom; SwitchToMode "locked"; }
  }

  scroll {
    bind "/" "f" { SwitchToMode "entersearch"; SearchInput 0; }
  }

  entersearch {
    bind "Ctrl c" "esc" { SwitchToMode "scroll"; }
    bind "enter" { SwitchToMode "search"; }
  }

  search {
    bind "n" { Search "down"; }
    bind "N" { Search "up"; }
    bind "c" { SearchToggleOption "CaseSensitivity"; }
    bind "o" { SearchToggleOption "WholeWord"; }
    bind "w" { SearchToggleOption "Wrap"; }
  }

  session {
    bind "d" { Detach; }
    bind "o" { SwitchToMode "normal"; }
    bind "p" { LaunchOrFocusPlugin "plugin-manager" { floating true; move_to_focused_tab true; }; SwitchToMode "locked"; }
    bind "w" { LaunchOrFocusPlugin "session-manager" { floating true; move_to_focused_tab true; }; SwitchToMode "locked"; }
  }

  renametab {
    bind "Ctrl c" { SwitchToMode "locked"; }
    bind "esc" { UndoRenameTab; SwitchToMode "tab"; }
  }

  shared_except "locked" "entersearch" "renametab" {
    bind "esc" "Ctrl space" { SwitchToMode "locked"; }
  }
}

plugins {
  plugin-manager location="zellij:plugin-manager"
  session-manager location="zellij:session-manager"
  zellij-tools location="file:target/wasm32-wasip1/debug/zellij-tools.wasm" {
    scratchpads {
      dev {
        command "nu"
        height "70%"
        origin "center"
        title "sh"
        width "80%"
      }
      git {
        command "bash" "-lc" "git status --short --branch; exec bash"
        height "35%"
        origin "bottom" "left"
        title "git"
        width "45%"
      }
      monitor {
        command "top"
        height "60%"
        origin "top" "right"
        title "mon"
        width "45%"
      }
      notes {
        command "nu"
        height "45%"
        origin "bottom" "right"
        title "note"
        width "50%"
      }
    }

    scratchpad_hide_strategy "minimize"

    zjstatus {
      // Logical zjstatus pipe name. This publishes to the zjstatus widget named
      // pipe_scratchpads, which is rendered below with {pipe_scratchpads}.
      pipe "scratchpads"

      // Top-level format placeholders:
      // - {current_items}: rendered items for the active tab
      // - {global_items}: rendered aggregate items across the session
      // - Global live/visible/hidden/rendered counts count pane instances, not
      //   aggregate item names. If the same scratchpad is open on two tabs, it
      //   contributes 2 to those counts while rendering once in {global_items}.
      // - {current_configured_count}, {global_configured_count}: configured
      //   scratchpads after include/exclude filters, before item rendering
      // - {current_rendered_count}, {global_rendered_count}: items rendered
      //   after empty item formats are filtered out
      // - {current_live_count}, {global_live_count}: scratchpads with a live pane
      // - {current_visible_count}, {global_visible_count}: visible items
      // - {current_hidden_count}, {global_hidden_count}: hidden/suppressed items
      // - {current_closed_count}, {global_closed_count}: configured but closed
      // - {other_configured_count}, {other_rendered_count}, {other_live_count},
      //   {other_visible_count}, {other_hidden_count}, {other_closed_count}:
      //   global count minus current count
      // - {current_focused_name}, {global_focused_name}: focused scratchpad name
      // - {current_focused_title}, {global_focused_title}: focused title
      format "#[fg=#808080]  {current_items}#[fg=#666666]+{other_live_count}"

      // Used when the rendered output is empty. Leave empty to avoid clearing a
      // previously populated zjstatus pipe during transient tab/pane updates.
      empty_format ""

      // Item format placeholders:
      // - {name}: scratchpad config name
      // - {title}: configured title, falling back to name
      // - {state}: visible, hidden, or closed
      // - {icon}: fixed state icon (visible ●, hidden ○, closed ×)
      // - {pane_id}, {tab_id}, {tab_position}: live pane/tab identifiers
      // - {is_focused}: true or false
      //
      // current_item_focused_format is an active-tab-only override for focused
      // scratchpads. If it is unset, normal state fallback is used.
      //
      // Format fallback order for non-focused items is:
      // - <scope>_item_<state>_format
      // - item_<state>_format
      // - <scope>_item_format
      // - item_format
      //
      // Set a state-specific format to "" to filter those items out. For
      // example, current_item_closed_format "" hides closed current-tab items.
      current_item_focused_format "#[fg=#7583FF,bold]{title} "
      current_item_visible_format "#[fg=#585d8d,bold]{title} "
      current_item_hidden_format "#[fg=#666666]{title} "
      current_item_closed_format ""

      // Optional separator overrides:
      // - item_separator applies to both scopes
      // - current_item_separator overrides current items only
      // - global_item_separator overrides global items only
      item_separator ""

      // Optional name filters, not used in this dev config:
      // include "dev" "monitor"
      // exclude "notes"
    }
  }
  zjstatus location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {
    pipe_scratchpads_format "{output} "
    pipe_scratchpads_rendermode "dynamic"
    datetime "#[fg=#888888,bold] {format} "
    datetime_format "%H:%M:%S"
    format_left "{mode} {tabs}"
    format_right "{pipe_scratchpads} {datetime}#[bg=#444444,fg=#ffffff,bold] {session} "
    format_space ""
    hide_frame_for_single_pane "false"
    mode_locked "#[bg=#444444,fg=#ffffff,bold] LOCKED "
    mode_normal "#[bg=green,fg=#222222,bold] NORMAL "
    mode_tab "#[bg=yellow,fg=#222222,bold] TAB "
    mode_pane "#[bg=magenta,fg=#222222,bold] PANE "
    mode_resize "#[bg=orange,fg=#222222,bold] RESIZE "
    mode_search "#[bg=blue,fg=#222222,bold] SEARCH "
    mode_entersearch "#[bg=blue,fg=#222222,bold] ENTERSEARCH "
    mode_renametab "#[bg=red,fg=#222222,bold] RENAMETAB "
    mode_session "#[bg=cyan,fg=#222222,bold] SESSION "
    tab_active "#[bg=#555555,fg=#ffffff,bold] {index} {name} "
    tab_normal "#[fg=#888888,bold] {index} {name} {bell_indicator}"
    tab_separator " "
    tab_bell_indicator "!"
    tab_flashing_bell_indicator "!!"
    tab_normal_bell "#[fg=#f38ba8,bg=$bg,bold] {index} {name} {bell_indicator} "
    tab_normal_flashing_bell "#[fg=$bg,bg=#f38ba8,bold] {index} {name} {bell_indicator} "
  }
}

load_plugins {
  zellij-tools
}

// vim: set ts=2 sw=2 tw=0 et :
